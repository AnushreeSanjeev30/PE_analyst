# ============================================================
# APPLICATION
# ============================================================

APP_NAME=PE-Analyst
APP_ENV=development
DEBUG=true

HOST=127.0.0.1
PORT=8000

# Browser origins allowed to call the API, as a JSON list. Defaults to the local frontend
# (http://localhost:5173 and http://127.0.0.1:5173). In production set it to the deployed
# frontend URL, with no trailing slash:
# CORS_ORIGINS=["https://your-frontend.example.com"]


# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=INFO


# ============================================================
# OPENAI
# ============================================================

OPENAI_API_KEY=

OPENAI_MODEL=gpt-5-mini

OPENAI_EMBEDDING_MODEL=text-embedding-3-small

EMBEDDING_DIMENSION=1536


# ============================================================
# DOCUMENT SEARCH (embeddings)
# ============================================================

# Which model turns document text into search vectors: auto | openai | gemini | local.
# "auto" uses OpenAI if OPENAI_API_KEY is set, else Gemini if GEMINI_API_KEY is set, else an
# offline keyword-hashing fallback that needs no key but only matches exact words.
# Gemini has a free tier: create a key at https://aistudio.google.com/apikey
# After changing provider, upload documents again so they are re-indexed.
EMBEDDING_PROVIDER=auto

GEMINI_API_KEY=


# ============================================================
# AGENT LLM (narration, memo, RAG answers)
# ============================================================

# Groq has a free tier: create a key at https://console.groq.com/keys
# Agents stay fully deterministic (no LLM) when the chosen provider has no key.
LLM_PROVIDER=groq

GROQ_API_KEY=

GROQ_MODEL=openai/gpt-oss-120b

# Optional: xAI Grok (paid). Set LLM_PROVIDER=xai to use it.
XAI_API_KEY=

XAI_MODEL=grok-4.3

# Optional override of the provider's default model, e.g. openai/gpt-oss-20b (faster) on Groq.
LLM_MODEL=

# Every agent LLM call is logged here as JSONL for review and fine-tuning.
LLM_LOG_DIR=data/llm_logs


# ============================================================
# DATABASE
# ============================================================

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pe_analyst

# Seconds to wait for the database before failing a request.
DB_CONNECT_TIMEOUT_SECONDS=5

# One audit_log row per API request. Set to false to run without a database for auditing.
AUDIT_LOG_ENABLED=true


# ============================================================
# AUTH
# ============================================================

# Signs login tokens. With APP_ENV=production the app refuses to start unless this is a unique
# value of at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60


# ============================================================
# VECTOR STORE
# ============================================================

# "local" needs no infrastructure. Use "pgvector" when Postgres+pgvector is running
# (docker-compose.yml sets this automatically for the containerized API).
VECTOR_STORE_PROVIDER=local

VECTOR_COLLECTION_NAME=pe_analyst_documents


# ============================================================
# DOCUMENT STORAGE
# ============================================================

UPLOAD_DIR=data/uploads

PROCESSED_DATA_DIR=data/processed

MAX_UPLOAD_SIZE_MB=50


# ============================================================
# DOCUMENT PROCESSING
# ============================================================

DOCUMENT_CHUNK_SIZE=1200

DOCUMENT_CHUNK_OVERLAP=200


# ============================================================
# RETRIEVAL
# ============================================================

RETRIEVAL_TOP_K=10

RERANK_TOP_K=5


# ============================================================
# AGENT WORKFLOW
# ============================================================

MAX_AGENT_ITERATIONS=10

ENABLE_AGENT_TRACING=true


# ============================================================
# EXTERNAL RESEARCH
# ============================================================

SEC_USER_AGENT=PE-Analyst your_email@example.com


# ============================================================
# MARKET DATA
# ============================================================

# "unconfigured" or "alphavantage" (free key: https://www.alphavantage.co/support/#api-key).
# With alphavantage, pass valuation_inputs.comparables.peer_tickers instead of peers.
MARKET_DATA_PROVIDER=unconfigured

MARKET_DATA_API_KEY=

MARKET_DATA_CACHE_DIR=data/market_cache


# ============================================================
# LBO DEFAULTS
# ============================================================

DEFAULT_HOLDING_PERIOD_YEARS=5

DEFAULT_TAX_RATE=0.25

DEFAULT_INTEREST_RATE=0.08