# ============================================================
# APPLICATION
# ============================================================

APP_NAME=PE-Analyst
APP_ENV=development
DEBUG=true

HOST=127.0.0.1
PORT=8000


# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=INFO


# ============================================================
# OPENAI
# ============================================================

OPENAI_API_KEY=your_openai_api_key_here

OPENAI_MODEL=gpt-5-mini

OPENAI_EMBEDDING_MODEL=text-embedding-3-small

EMBEDDING_DIMENSION=1536


# ============================================================
# AGENT LLM (narration, memo, RAG answers)
# ============================================================

# Groq has a free tier: create a key at https://console.groq.com/keys
# Agents stay fully deterministic (no LLM) when the chosen provider has no key.
LLM_PROVIDER=groq

GROQ_API_KEY=

GROQ_MODEL=llama-3.3-70b-versatile

# Optional: xAI Grok (paid). Set LLM_PROVIDER=xai to use it.
XAI_API_KEY=

XAI_MODEL=grok-4.3

# Optional override of the provider's default model, e.g. openai/gpt-oss-120b on Groq.
LLM_MODEL=

# Every agent LLM call is logged here as JSONL for review and fine-tuning.
LLM_LOG_DIR=data/llm_logs


# ============================================================
# DATABASE
# ============================================================

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pe_analyst


# ============================================================
# AUTH
# ============================================================

SECRET_KEY=change-me-to-a-long-random-value

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60


# ============================================================
# VECTOR STORE
# ============================================================

# "local" needs no infrastructure. Use "pgvector" when Postgres+pgvector is running
# (docker-compose.yml sets this automatically for the containerized API).
VECTOR_STORE_PROVIDER=local

VECTOR_COLLECTION_NAME=pe_analyst_documents


# ============================================================
# DOCUMENT STORAGE
# ============================================================

UPLOAD_DIR=data/uploads

PROCESSED_DATA_DIR=data/processed

MAX_UPLOAD_SIZE_MB=50


# ============================================================
# DOCUMENT PROCESSING
# ============================================================

DOCUMENT_CHUNK_SIZE=1200

DOCUMENT_CHUNK_OVERLAP=200


# ============================================================
# RETRIEVAL
# ============================================================

RETRIEVAL_TOP_K=10

RERANK_TOP_K=5


# ============================================================
# AGENT WORKFLOW
# ============================================================

MAX_AGENT_ITERATIONS=10

ENABLE_AGENT_TRACING=true


# ============================================================
# EXTERNAL RESEARCH
# ============================================================

SEC_USER_AGENT=PE-Analyst your_email@example.com


# ============================================================
# MARKET DATA
# ============================================================

# "unconfigured" or "alphavantage" (free key: https://www.alphavantage.co/support/#api-key).
# With alphavantage, pass valuation_inputs.comparables.peer_tickers instead of peers.
MARKET_DATA_PROVIDER=unconfigured

MARKET_DATA_API_KEY=

MARKET_DATA_CACHE_DIR=data/market_cache


# ============================================================
# LBO DEFAULTS
# ============================================================

DEFAULT_HOLDING_PERIOD_YEARS=5

DEFAULT_TAX_RATE=0.25

DEFAULT_INTEREST_RATE=0.08